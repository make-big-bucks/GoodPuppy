{
  "name": "good-puppy",
  "version": "0.1.0",
  "description": "A tiny desktop pet app built with Electron.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "dist:users": "node scripts/build-users.js"
  },
  "keywords": [
    "desktop-pet",
    "electron",
    "puppy"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.goodpuppy.desktop",
    "productName": "GoodPuppy",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "state_images/**/*",
      "img/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "img/dog.ico",
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "electron": "42.3.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2"
  }
}
