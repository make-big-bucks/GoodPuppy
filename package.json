{
  "name": "good-puppy",
  "version": "0.1.0",
  "description": "A desktop pet app built with Tauri.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:peer": "DEV_PORT=1421 vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev:peer": "tauri dev --config src-tauri/tauri.peer.conf.json",
    "gen:skins": "node tools/generate-skins.mjs",
    "test": "vitest run",
    "test:native": "node tools/native-smoke.mjs",
    "test:db": "python3 tools/verify-database.py"
  },
  "keywords": [
    "desktop-pet",
    "tauri",
    "puppy"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.3",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1"
  }
}
