{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GoodPuppy",
  "version": "0.1.0",
  "identifier": "com.goodpuppy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": { "csp": null },
    "windows": [
      {
        "label": "login",
        "title": "GoodPuppy",
        "url": "windows/login.html",
        "width": 360,
        "height": 540,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "center": true
      },
      {
        "label": "main",
        "title": "GoodPuppy",
        "url": "windows/pet.html",
        "width": 150,
        "height": 220,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
