{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GoodPuppy",
  "version": "../package.json",
  "identifier": "com.goodpuppy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "lounge",
        "title": "",
        "url": "windows/lounge.html",
        "width": 1120,
        "height": 720,
        "minWidth": 1040,
        "minHeight": 680,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "center": true
      },
      {
        "label": "main",
        "title": "GoodPuppy",
        "url": "windows/pet.html",
        "width": 150,
        "height": 120,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "acceptFirstMouse": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://raw.githubusercontent.com/make-big-bucks/GoodPuppy/updates/stable.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
